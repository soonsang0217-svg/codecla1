# --- Team password gate ---
# Shared password every team member enters once; the session is then kept in a cookie.
TEAM_PASSWORD=
# Random long string used to sign the session cookie. Generate with:
# openssl rand -base64 32
SESSION_SECRET=

# --- Database (Turso: https://turso.tech, free tier) ---
# Create a database with the Turso CLI (`turso db create interview-drafts`) or
# the Turso dashboard, then copy its libsql:// URL and an auth token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- AI provider ---
# "gemini" (default) or "anthropic". Only step 3 (AI 생성) calls this — every
# other step is free.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
