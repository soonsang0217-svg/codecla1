# --- Storage (Upstash Redis, free tier: https://upstash.com) ---
# Create a database at console.upstash.com, then copy the REST URL/token
# from its "REST API" tab. Used to persist Google tokens + user settings.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google OAuth (Calendar + Tasks) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client, e.g.
# https://<your-app>.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Comma-separated list of Google account emails allowed to sign in.
# Leave empty to allow any Google account (NOT recommended).
ALLOWED_EMAIL=you@example.com

# Random long string used to sign the session cookie. Generate with:
# openssl rand -base64 32
SESSION_SECRET=

# --- Stock quotes ---
# Overseas tickers (e.g. AAPL) use Finnhub (free tier: https://finnhub.io).
# 6-digit Korean codes (e.g. 005930) use Naver Finance and need no key.
FINNHUB_API_KEY=
STOCK_SYMBOLS=AAPL,MSFT,NVDA,005930

# --- News (Google News RSS — free, no API key or signup needed) ---
# Category tabs and search are chosen in the app itself; this only sets the
# default language/region.
NEWS_COUNTRY=kr

# --- Commute / directions (Kakao Developers: https://developers.kakao.com) ---
# REST API key with "Kakao Local" and "Kakao Mobility - Directions" products enabled.
KAKAO_REST_API_KEY=
HOME_ADDRESS=

# --- Daily email briefing (sent by a Vercel Cron Job every morning) ---
# Resend (free tier, no signup fee: https://resend.com). Sign up using the
# same email address you want the briefing delivered to — Resend lets
# unverified accounts send to their own signup address with no domain setup.
RESEND_API_KEY=
# Address the daily briefing email is sent to.
BRIEFING_EMAIL_TO=
# Optional "from" header. Defaults to Resend's shared sandbox address, which
# works fine without owning/verifying a domain.
# EMAIL_FROM=Morning Briefing <onboarding@resend.dev>
# Shared secret Vercel Cron sends back as `Authorization: Bearer <value>` so
# only Vercel's scheduler (not the public internet) can trigger the email
# job. Generate with `openssl rand -base64 32`; Vercel picks this up
# automatically once it's set as a project env var, no extra config needed.
CRON_SECRET=
