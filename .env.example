# --- Google OAuth (Calendar + Tasks) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client, e.g.
# http://<home-server-ip>:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Comma-separated list of Google account emails allowed to sign in.
# Leave empty to allow any Google account (NOT recommended).
ALLOWED_EMAIL=you@example.com

# Random long string used to sign the session cookie. Generate with:
# openssl rand -base64 32
SESSION_SECRET=

# --- Stock quotes (Finnhub, free tier: https://finnhub.io) ---
FINNHUB_API_KEY=
STOCK_SYMBOLS=AAPL,MSFT,NVDA

# --- News (NewsAPI.org, free tier: https://newsapi.org) ---
NEWSAPI_KEY=
NEWS_COUNTRY=kr
NEWS_QUERY=

# --- Commute / directions (Kakao Developers: https://developers.kakao.com) ---
# REST API key with "Kakao Local" and "Kakao Mobility - Directions" products enabled.
KAKAO_REST_API_KEY=
HOME_ADDRESS=

# --- Storage ---
# Directory where the SQLite database (settings + Google tokens) is stored.
DATA_DIR=./data
